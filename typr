#!/usr/bin/env python3
"""Typr — Terminal-native typing trainer launcher."""

import os
import sys

# Ensure src/ is on sys.path when running from repository root
REPO_SRC = os.path.join(os.path.dirname(os.path.abspath(__file__)), "src")
if os.path.isdir(REPO_SRC) and REPO_SRC not in sys.path:
    sys.path.insert(0, REPO_SRC)

from typr.cli import main

if __name__ == "__main__":
    sys.exit(main())
